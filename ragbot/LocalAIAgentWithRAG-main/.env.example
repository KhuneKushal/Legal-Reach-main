# ============================================================
# Legal Reach RAG — Environment Configuration Example
# Copy this file to .env and fill in your values.
# ============================================================

# ─── Ollama Server ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# LLM model served by Ollama (must be pulled first)
LLM_MODEL=llama3.2

# Embedding model served by Ollama
EMBEDDING_MODEL=mxbai-embed-large

# ─── Hardware / Performance ──────────────────────────────────
# Device: 'cuda' for GPU, 'cpu' for CPU-only
DEVICE=cpu

# Max GPU memory to allocate (ignored when DEVICE=cpu)
MAX_GPU_MEMORY=3.5

# Enable 8-bit quantization to reduce VRAM usage
QUANTIZATION_8BIT=True

# ─── Document Chunking ───────────────────────────────────────
# Chunk size in tokens (512 is optimal for legal documents)
CHUNK_SIZE=512

# Overlap between chunks in tokens
CHUNK_OVERLAP=50

# ─── Vector Store ────────────────────────────────────────────
COLLECTION_NAME=legal_documents
VECTOR_STORE_PATH=./vectorstore

# Number of document chunks to retrieve per query
RETRIEVAL_K=6

# ─── LLM Generation Parameters ───────────────────────────────
MAX_TOKENS=512

# Low temperature = more deterministic (recommended for legal)
TEMPERATURE=0.1

TOP_P=0.9
TOP_K=50

# ─── File Handling ───────────────────────────────────────────
# Max file size in bytes (default: 50 MB)
MAX_FILE_SIZE=50000000

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── GPU Monitoring ──────────────────────────────────────────
MONITOR_GPU=False
GPU_TEMP_WARNING=70
GPU_TEMP_CRITICAL=80
GPU_MEMORY_WARNING=0.80
GPU_MEMORY_CRITICAL=0.90
